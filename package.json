{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate-writeups-data": "ts-node scripts/generate-writeups-data.ts",
    "build": "npm run generate-writeups-data && next build --webpack",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
